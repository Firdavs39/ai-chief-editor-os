APP_ENV=dev
# Mode flags — see docs/SAFETY_MODEL.md for the full state machine.
MOCK_MODE=true
DEMO_MODE=true
LIVE_MODE=false
DRY_RUN_PUBLISH=true
PUBLISHING_ENABLED=false
WORKER_HEARTBEAT_TTL_SECONDS=120

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/chief_editor
REDIS_URL=redis://redis:6379/0
TIMEZONE=Asia/Tashkent

# --- Secrets Vault ----------------------------------------------------------
# Generate with: python -m chief_editor.services.secrets generate-key
# If MASTER_ENCRYPTION_KEY is missing the vault is disabled but the app
# still runs — env-based config below is the fallback.
# Back this value up securely. Losing it makes every stored secret unreadable.
MASTER_ENCRYPTION_KEY=
# Comma-separated old Fernet keys. Used for read-only decryption during a
# rolling rotation. Remove once `rotate-key` has re-encrypted all rows.
MASTER_ENCRYPTION_KEYS_LEGACY=
# Shared admin token required on every /secrets/* request (X-Admin-Token).
# Mandatory whenever the API is reachable outside loopback. See SECRETS_VAULT.md.
ADMIN_TOKEN=

LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama / OpenAI-compatible (e.g. Kimi K2.6 via Ollama Cloud or local Ollama).
# - For Ollama Cloud: OLLAMA_BASE_URL=https://ollama.com  + OLLAMA_API_KEY=...
# - For local Ollama: OLLAMA_BASE_URL=http://localhost:11434  (key is auto-resolved to `ollama`)
# Override OLLAMA_MODEL if you want a different model than Kimi K2.6.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=kimi-k2.6:cloud

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_TARGET_CHANNEL_ID=
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION_NAME=chief_editor_session

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-chief-editor-os-dev

POSTIZ_BASE_URL=
POSTIZ_API_KEY=
POSTIZ_THREADS_INTEGRATION_ID=
POSTIZ_REDDIT_INTEGRATION_ID=

API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Deployment identity (FastAPI CORS + UI honesty)
# Comma-separated origins. Empty falls back to "*" — only acceptable in dev.
FRONTEND_ORIGIN=
PUBLIC_API_URL=

# Structured logging. LOG_FORMAT=json forces JSON output (auto in APP_ENV=prod).
LOG_LEVEL=INFO
LOG_FORMAT=

COLLECT_INTERVAL_SECONDS=300
GENERATE_INTERVAL_SECONDS=600
PUBLISH_INTERVAL_SECONDS=30
